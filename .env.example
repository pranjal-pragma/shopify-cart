APP_ENV=development
APP_DEBUG=true
APP_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
APP_DATABASE_URL=postgresql+asyncpg://shopify:shopify@localhost:5432/shopify_app
APP_SHOPIFY_CLIENT_ID=replace-with-dev-dashboard-client-id
APP_SHOPIFY_CLIENT_SECRET=replace-with-dev-dashboard-client-secret
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
APP_SHOPIFY_API_VERSION=2026-07
APP_HTTP_TIMEOUT_SECONDS=10
APP_LOG_LEVEL=INFO
APP_WEBHOOK_MAX_BODY_BYTES=1048576


