<div
  class="gk-cart-root"
  data-gokwik-cart-root
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-change-url="{{ routes.cart_change_url }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-open-on-add="{{ block.settings.open_on_add }}"
  style="--gk-cart-accent: {{ block.settings.accent_color }};"
>
  <button class="gk-cart-overlay" type="button" aria-label="Close cart" data-gk-close tabindex="-1"></button>

  <aside
    class="gk-cart-drawer"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="gk-cart-title"
    data-gk-drawer
  >
    <header class="gk-cart-header">
      <div>
        <p class="gk-cart-eyebrow">Your order</p>
        <h2 id="gk-cart-title">{{ block.settings.drawer_title | escape }}</h2>
      </div>
      <button class="gk-cart-icon-button" type="button" aria-label="Close cart" data-gk-close>
        <span aria-hidden="true">&times;</span>
      </button>
    </header>

    <div class="gk-cart-notice" role="status" aria-live="polite" data-gk-notice></div>

    <div class="gk-cart-content" data-gk-content>
      <div class="gk-cart-loading" data-gk-loading>
        <span class="gk-cart-spinner" aria-hidden="true"></span>
        <span>Loading your cart</span>
      </div>

      <div class="gk-cart-empty" data-gk-empty hidden>
        <span class="gk-cart-empty-icon" aria-hidden="true"></span>
        <h3>{{ block.settings.empty_title | escape }}</h3>
        <a class="gk-cart-secondary-button" href="{{ block.settings.continue_link }}" data-gk-continue>
          {{ block.settings.continue_label | escape }}
        </a>
      </div>

      <ul class="gk-cart-items" data-gk-items aria-label="Cart items"></ul>
    </div>

    <footer class="gk-cart-footer" data-gk-footer hidden>
      <div class="gk-cart-total-row">
        <span>Estimated total</span>
        <strong data-gk-total></strong>
      </div>
      <p class="gk-cart-tax-note">Taxes and shipping calculated at checkout.</p>
      <a class="gk-cart-checkout-button" href="/checkout">
        {{ block.settings.checkout_label | escape }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </footer>
  </aside>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "target": "body",
  "javascript": "gokwik-cart.js",
  "stylesheet": "gokwik-cart.css",
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#202124"
    },
    {
      "type": "text",
      "id": "drawer_title",
      "label": "Cart title",
      "default": "Your cart"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty cart title",
      "default": "Your cart is empty"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Continue shopping label",
      "default": "Continue shopping"
    },
    {
      "type": "url",
      "id": "continue_link",
      "label": "Continue shopping link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Checkout securely"
    },
    {
      "type": "checkbox",
      "id": "open_on_add",
      "label": "Open cart after add to cart",
      "default": true
    }
  ]
}
{% endschema %}
